{"code":"SYN","name":"Synthesis (Seventh)","term":"FA26","termName":"Fall 2026","courses":{"SYN 1":{"t":"Communicating for a Changing Planet","u":"4","desc":"Synthesis 1 asks students to critically examine through an interdisciplinary and antiracist lens how we communicate about the climate crisis in order to address the question of how we get people to respond and take action. Through a variety of assignments and activities, students develop an awareness of both the message of a text and how the author crafted that message. They learn how to assess the purpose, audience, and context of different rhetorical situations.","pre":"Seventh College students only, completion of UC Entry Level Writing requirement, must be taken for a letter grade to count toward Seventh College general-education requirements. Duplicate credit with SYN 1R.","unl":["ENG 100D","LTWR 8A","LTWR 8B","LTWR 8C","PHIL 27","SYN 1R","SYN 2","SYN 2R","SYN 100","SYN 100GS"],"hist":[["SP26",4,3.96,100,0,0,0,0,0,0,0],["SP26",21,3.72,80,13.3,6.7,0,0,0,0,0],["SP26",3,3.79,92.5,2.5,2.5,0,2.5,0,0,0],["SP26",0,3.81,92.5,2.5,2.5,0,2.5,0,0,0],["SP26",16,3.93,95,2.5,2.5,0,0,0,0,0],["SP26",8,3.82,92.5,5,2.5,0,0,0,0,0],["SP26",13,3.85,91.6,6.7,0,1.7,0,0,0,0],["SP26",9,3.7,90,0,5,0,5,0,0,0],["SP26",2,3.91,90,7.5,0,0,0,0,0,0],["SP26",11,3.96,100,0,0,0,0,0,0,0],["SP26",7,3.86,87.5,12.5,0,0,0,0,0,0],["SP26",10,3.97,100,0,0,0,0,0,0,0],["SP26",12,3.92,95,5,0,0,0,0,0,0],["SP26",23,3.9,90,5,1.7,0,0,0,0,0],["SP26",18,3.91,95,5,0,0,0,0,0,0],["WI26",4,3.97,100,0,0,0,0,0,0,0],["WI26",21,3.88,94.7,5.3,0,0,0,0,0,0],["WI26",3,3.9,92.5,5,0,0,0,0,2.5,0],["WI26",0,3.96,95,5,0,0,0,0,0,0],["WI26",16,3.97,100,0,0,0,0,0,0,0],["WI26",5,3.98,100,0,0,0,0,0,0,0],["WI26",13,3.92,90,10,0,0,0,0,0,0],["WI26",2,3.93,92.1,7.9,0,0,0,0,0,0],["WI26",11,3.98,97.5,2.5,0,0,0,0,0,0],["SP25",4,3.81,85,15,0,0,0,0,0,0],["SP25",3,3.95,100,0,0,0,0,0,0,0],["SP25",0,3.95,94.9,5.1,0,0,0,0,0,0],["SP25",17,3.93,95,5,0,0,0,0,0,0],["SP25",5,3.98,100,0,0,0,0,0,0,0],