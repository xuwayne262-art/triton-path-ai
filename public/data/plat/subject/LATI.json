ct ethnographic research in local Latin American diasporic communities by selecting a particular regional dish and documenting its history, culture, and contemporary production.","pre":null,"unl":[],"hist":[["SP26",0,3.09,61.3,8,8,0,13.3,0,6.7,1.3],["FA25",0,3.14,42.2,30.9,14,2.8,4.2,1.4,2.8,1.4],["SP25",0,3.59,53.3,23.3,3.3,0,0,0,6.7,6.7]],"ge":["erc:Regional Specialization · Latin America","campus:DEI"],"gpa":3.273,"aRate":52.3,"terms":3,"offered":1,"seatUrl":"https://tss.ucsd.edu/fiori#ZUSModule-display?TileType=MYMOD&/Detail/EventPackage/SM/6472/00000000/0/0/0/00000000-0000-0000-0000-000000000000/152995/2026/2/?","tss":"https://tss.ucsd.edu/fiori#ZUSModule-display?TileType=MYMOD&/Detail/EventPackage/SM/6472/00000000/0/0/0/00000000-0000-0000-0000-000000000000/152995/2026/2/?","res":"Limited to class level: Junior, Senior","fa":["Troy Kokinis"],"seatsAt":"2026-09-21T15:23:00.000Z","profs":[{"i":"Troy Andreas Kokinis","g":3.273,"A":52.2667,"B":20.7333,"C":8.4433,"D":0.9367,"F":5.84,"W":0.4667,"P":5.3767,"NP":3.13,"n":3,"y":26,"cur":1,"rq":3.2,"rd":2.4,"rw":59,"rn":28,"rid":2576509}],"sec":[["A00","LE","MWF","11:00a","11:50a","Gildred Latin American Studies Building","LASB 4","Troy Kokinis",0,30,0,0,30,"E 00004616",["152995","152996","152997","152998","152999","153000","153638","159519","221","222","3399","3400"],660,710,"LASB","AC",""]]},"LATI 170":{"t":"Social Science Research in Latin America","u":"4","desc":"The objective of the course is to survey the important contributions of social science research in Latin America in understanding some of the most pressing issues facing our societies today. The class will synthesize the contributions of Latin American researchers and activists to social science research in visible complex issues related to socioeconomic inequality, citizenship, violence and insecurity, justice, and migration.","pre":null,"unl":[],"hist":[["FA25",0,3.8,77.5,10.3,1.7,0,1.7,1.7,3.4,0],["WI25",0,3.76,81.5,7.9,2.6,0,2.6,0,2.6,0],["WI24",0,4,100,