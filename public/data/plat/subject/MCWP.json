 version of the second course of sequence in reading and writing which satisfies the Muir College graduation requirement in writing. Required of all Muir College first-year students and of transfer students. MCWP 50R focuses on advanced skills of argument and analyses. Students engage in close reading of texts, weekly writing and revision, and individual conferences. This class is held synchronously online. Students will not receive credit for both MCWP 50 and MCWP 50R. Must be taken for a letter grade to satisfy the Muir College writing requirement. This is a distance education course.","pre":null,"unl":["CSE 194","PHIL 27"],"hist":[["SP26",0,2.9,37.5,37.5,12.5,0,10,2.5,0,0],["WI26",0,2.97,41.3,34.4,8.6,6.9,5.2,1.7,0,1.7],["SP25",0,2.88,45.9,27,5.4,8.1,10.8,2.7,0,0],["SP24",0,2.94,31,24.1,18.9,5.2,1.7,3.4,0,0]],"ge":[],"gpa":2.924,"aRate":38.9,"terms":4,"offered":0,"seatUrl":null,"tss":null,"res":null,"fa":[],"profs":[{"i":"Elizabeth Deen Miller","g":2.924,"A":38.925,"B":30.75,"C":11.355,"D":5.04,"F":6.9225,"W":2.59,"P":0,"NP":0.43,"n":4,"y":26,"cur":0,"rq":3.6,"rd":3.8,"rw":61,"rn":47,"rid":1967900}],"sec":[]},"MCWP 500":{"t":"Apprentice Teaching in MCWP","u":"4","desc":null,"pre":null,"unl":[],"hist":[],"ge":[],"gpa":null,"aRate":null,"terms":0,"offered":1,"seatUrl":"https://tss.ucsd.edu/fiori#ZUSModule-display?TileType=MYMOD&/Detail/EventPackage/SM/5190/00000000/0/0/0/00000000-0000-0000-0000-000000000000/153268/2026/2/?","tss":"https://tss.ucsd.edu/fiori#ZUSModule-display?TileType=MYMOD&/Detail/EventPackage/SM/5190/00000000/0/0/0/00000000-0000-0000-0000-000000000000/153268/2026/2/?","res":"Limited to academic level: Graduate","fa":["K Wayne Yang"],"seatsAt":"2026-09-21T15:29Z","profs":[{"i":"K Wayne Yang","g":0,"A":0,"B":0,"C":0,"D":0,"F":0,"W":0,"P":0,"NP":0,"n":0,"y":null,"cur":1,"rq":2.9,"rd":1.6,"rw":43,"rn":7,"rid":2232051}],"sec":[["A00","SE","W","5:00p","6:20p","Humanities and Social Sciences","HSS 2346A","K Wayne Yang",9,10,0,0,1,"E 00002974",["153268","