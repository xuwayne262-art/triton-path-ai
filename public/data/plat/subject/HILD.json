torical analysis and context. Satisfies the lower-division requirement for the law and society minor.","pre":null,"unl":[],"hist":[],"ge":["muir:Humanities / Arts / Language"],"gpa":null,"aRate":null,"terms":0,"offered":0,"seatUrl":null,"tss":null,"res":null,"fa":[],"profs":[],"sec":[]},"HILD 60":{"t":"Global Black History through Biography","u":"4","desc":"This course touches upon prominent themes in global black history through the study of impactful black figures. These people and their experiences shine a light on some of the most momentous, compelling, and fascinating events to have shaped world history from the seventeenth century to the present day. The topics of analysis will include the struggle against European colonialism, activism carried out by athletes and musicians, and international campaigns against U.S. racial violence.","pre":null,"unl":[],"hist":[["WI26",0,3.65,62.9,19.3,1.6,1.6,0,1.6,6.5,1.6],["WI24",0,3.57,69.8,5.7,0,0,7.5,1.9,9.4,5.7]],"ge":["muir:Humanities / Arts / Language","erc:Regional Specialization · Africa","erc:Regional Specialization · Americas / Multi-Ethnic US","eighth:Breadth · Humanities","campus:DEI"],"gpa":3.607,"aRate":66.3,"terms":2,"offered":0,"seatUrl":null,"tss":null,"res":null,"fa":[],"profs":[{"i":"Jessica Lynn Graham","g":3.607,"A":66.35,"B":12.48,"C":0.805,"D":0.805,"F":3.77,"W":1.745,"P":7.94,"NP":3.635,"n":2,"y":26,"cur":0,"rq":4.8,"rd":2.2,"rw":94,"rn":39,"rid":1834832}],"sec":[]},"HILD 7A":{"t":"Race and Ethnicity in the United States","u":"4","desc":"Lectures and discussions surveying the topics of race, slavery, demographic patterns, ethnic variety, rural and urban life in the United States, with special focus on European, Asian, and Mexican immigration.","pre":null,"unl":["CSE 194","EDS 120","HIEA 137","HIEU 116A","HITO 106","HITO 136","HIUS 141","HIUS 146"],"hist":[["FA25",1,3.57,58.5,13.1,4.6,1.1,1.7,2.3,16.2,1.4],["WI25",0,3.66,63.9,14.2,3.3,0.3,0.8,0.8,15.3,1.1],["FA23",0,3.56,52.8,20,4.6,0.3,0.5,1.4,18.4,1.