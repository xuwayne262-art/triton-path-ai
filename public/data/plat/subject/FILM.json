{"code":"FILM","name":"Film Studies","term":"FA26","termName":"Fall 2026","courses":{"FILM 170":{"t":"Cinematic Arts Practicum","u":"4","desc":"A practicum course required of all cinematic arts majors, where students are mentored as part of an external internship or community-engagement project.","pre":"open to cinematic arts majors only.","unl":[],"hist":[],"ge":[],"gpa":null,"aRate":null,"terms":0,"offered":0,"seatUrl":null,"tss":null,"res":null,"fa":[],"profs":[],"sec":[]},"FILM 179":{"t":"Fundamentals of Animation","u":"4","desc":"A hands-on introduction to the fundamentals of 2-D animation, including both handmade and digitally designed approaches. Students will learn to analyze, understand, and incorporate strategies to apply traditional and experimental compositional approaches to animated storytelling. Recommended preparation is one of the following: COMM 101D, COMM 101K, COMM 101N, LTWR 110, TDPW 104, VIS 172, VIS 174, VIS 175, VIS 176, VIS 177, VIS 178, or VIS 179. Students may not receive credit for both FILM 179 and VIS 173.","pre":"open to cinematic arts majors and media majors. FILM 71 or VIS 60 and FILM 72 or VIS 70N.","unl":["FILM 180"],"hist":[["SP26",0,3.77,59,18.1,0,0,0,0,18.1,4.5],["WI26",0,3.4,59,13.6,22.7,0,0,0,4.5,0],["FA25",0,3.33,59,18.1,0,4.5,4.5,4.5,9.1,0]],"ge":[],"gpa":3.495,"aRate":59,"terms":3,"offered":1,"seatUrl":"https://tss.ucsd.edu/fiori#ZUSModule-display?TileType=MYMOD&/Detail/EventPackage/SM/6201/00000000/0/0/0/00000000-0000-0000-0000-000000000000/153547/2026/2/?","tss":"https://tss.ucsd.edu/fiori#ZUSModule-display?TileType=MYMOD&/Detail/EventPackage/SM/6201/00000000/0/0/0/00000000-0000-0000-0000-000000000000/153547/2026/2/?","res":"Limited to class level: Junior, Senior; Limited to major: Cinematic Arts, Visual Arts (Media)","fa":["Marty Davis"],"seatsAt":"2026-09-21T15:19:00.000Z","profs":[{"i":"Marty Davis","g":3.495,"A":59,"B":16.6,"C":7.5667,"D":1.5133,"F":1.5133,"W":1.5133,"P":10.5767,"NP":1.5133,"n":3,"y":26,"cur":1,"rq":